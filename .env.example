# Supabase PostgreSQL Credentials (Required)
# Find these in Supabase Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Or legacy/server keys:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Real Slack Incoming Webhook URL for live talent manager notifications
SLACK_WEBHOOK_URL=

# Optional: Google Apps Script Web App URL to append Google Sheet rows
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional: Direct Free Email via Gmail SMTP (recommended — zero third-party SaaS)
# Generate an App Password in Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or custom SMTP server:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=CreatorsMela IRIS <you@gmail.com>

# Optional: Or free Email via Google Apps Script MailApp webhook URL
EMAIL_WEBHOOK_URL=

# Optional: Or Resend API Key + recipient for email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=IRIS Collab OS <onboarding@resend.dev>
TALENT_MANAGER_EMAIL=talent-ops@creatorsmela.com
