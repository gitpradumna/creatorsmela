# Supabase PostgreSQL Credentials (Required)
# Find these in Supabase Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Or legacy/server keys:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Real Slack Incoming Webhook URL for live talent manager notifications
SLACK_WEBHOOK_URL=

# Optional: Google Apps Script Web App / Zapier / Make webhook URL to append Google Sheet rows
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional: Any custom webhook endpoint to receive signed deal events
CUSTOM_WEBHOOK_URL=

# Optional: Secret used to sign outbound webhooks (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=creatorsmela-iris-dev-secret

# Optional: Resend API Key + recipient for live email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=IRIS Collab OS <onboarding@resend.dev>
TALENT_MANAGER_EMAIL=talent-ops@creatorsmela.com
